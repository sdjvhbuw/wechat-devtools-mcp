{
  "name": "wechat-devtools-mcp",
  "version": "1.0.0",
  "description": "MCP server for WeChat DevTools: official CLI project operations and mini program simulator automation.",
  "license": "MIT",
  "author": "sdjvhbuw",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "wechat-devtools-mcp": "src/server.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sdjvhbuw/wechat-devtools-mcp.git"
  },
  "homepage": "https://github.com/sdjvhbuw/wechat-devtools-mcp#readme",
  "bugs": {
    "url": "https://github.com/sdjvhbuw/wechat-devtools-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wechat",
    "wechat-devtools",
    "miniprogram",
    "automation",
    "ai-agent"
  ],
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/runtime.js && node --check src/session.js && node --check src/server.js && node --check scripts/e2e.js && node --check scripts/cli-e2e.js && node --check scripts/smoke.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:e2e",
    "test:e2e": "node scripts/e2e.js",
    "test:cli": "node scripts/cli-e2e.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "miniprogram-automator": "^0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "prettier": "^3.9.10"
  }
}
