# 微信开发者工具安装目录
WECHAT_DEVTOOLS_DIR=C:\Program Files (x86)\Tencent\微信web开发者工具

# 默认小程序项目（可省略，调用工具时再传 projectPath）
WECHAT_DEVTOOLS_PROJECT=C:\path\to\your-miniprogram

# 自动化端口
WECHAT_DEVTOOLS_AUTOMATION_PORT=9420

# 截图输出目录
WECHAT_DEVTOOLS_MCP_OUTPUT_DIR=C:\path\to\wechat-devtools-mcp\output

# 上传开关（默认关闭）
# WECHAT_DEVTOOLS_MCP_ALLOW_UPLOAD=1

# 服务端口预检查（默认开启，设为 1 跳过）
# WECHAT_DEVTOOLS_SKIP_SERVICE_PORT_CHECK=1

# 退出 IDE 后残留 .ide 端口文件的自动清理（默认开启，设为 1 禁用）
# WECHAT_DEVTOOLS_NO_STALE_CLEANUP=1

# 可选：IDE 安全设置里的 CLI access token
# WECHAT_DEVTOOLS_CLI_TOKEN=
